// Shared build settings. Values here are configuration, not secrets: nothing secret belongs
// in xcconfig files because they're committed to the repository.
//
// Note: "//" starts a comment in xcconfig, so URLs use "/$()/" to keep the double slash.

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Set your Apple Developer Team ID here or in Xcode's Signing & Capabilities.
DEVELOPMENT_TEAM =

PRODUCT_BUNDLE_IDENTIFIER = app.delore.ios

// Public copies of in-app Privacy / Terms for store listings. Host docs/legal/*.html
// at these URLs before submitting. The app itself shows Privacy, FAQ, and Terms in-app.
DL_PRIVACY_URL = https:/$()/kandalintsev.com/retract/privacy
DL_SUPPORT_URL = mailto:contact@kandalintsev.com
DL_TERMS_URL = https:/$()/kandalintsev.com/retract/terms

// Must match App Store Connect and App/StoreKit/DeLore.storekit.
DL_PRODUCT_ONE_TIME = app.delore.cleanup.single
DL_PRODUCT_PRO_MONTHLY = app.delore.pro.monthly
DL_PRODUCT_PRO_YEARLY = app.delore.pro.yearly
DL_PRODUCT_PRO_MONTHLY_PROMO = app.delore.pro.monthly.promo
DL_PRODUCT_PRO_YEARLY_PROMO = app.delore.pro.yearly.promo

// Lifetime number of messages free users can clean.
DL_FREE_LIMIT = 100

// No analytics backend ships with the app. Flip only after wiring a privacy-preserving sink.
DL_ANALYTICS_ENABLED = NO

// Publisher notify (see workers/notify). Leave empty to disable. Override in Secrets.xcconfig.
DL_NOTIFY_URL =
DL_NOTIFY_SECRET =
